---
import config from '../config/config.json';
import SeoMeta from '../components/SeoMeta.astro';

interface Props {
  /** Webflow page id – the interactions (IX2) bundled in /js/webflow.js are keyed by it. */
  pageId: string;
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { pageId, title, description, image, type, noindex } = Astro.props;
const { siteId } = config.webflow;
---

<!doctype html>
<html data-wf-page={pageId} data-wf-site={siteId} lang={config.site.language}>
  <head>
    <meta charset="utf-8" />
    <SeoMeta title={title} description={description} image={image} type={type} noindex={noindex} />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta name="generator" content={Astro.generator} />
    <link href="/css/normalize.css" rel="stylesheet" type="text/css" />
    <link href="/css/webflow.css" rel="stylesheet" type="text/css" />
    <link href="/css/inkrow-astro-theme.webflow.css" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous" />
    <script is:inline src="https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js" type="text/javascript"></script>
    <script is:inline type="text/javascript">WebFont.load({ google: { families: ['Geist:300,400,500,600,700'] } });</script>
    <script is:inline type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
    <link href="/images/favicon.svg" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" />
    <link href="/images/favicon-dark.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link href="/images/webclip.svg" rel="apple-touch-icon" />
  </head>
  <body>
    <slot />
    <script is:inline src="/js/jquery-3.5.1.min.js" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="></script>
    <script is:inline src="/js/webflow.js" type="text/javascript"></script>
  </body>
</html>
