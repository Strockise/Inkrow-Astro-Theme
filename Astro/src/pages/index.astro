---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Cta from '../components/Cta.astro';
import BlogCard from '../components/cards/BlogCard.astro';
import CategoryCard from '../components/cards/CategoryCard.astro';
import TeamCard from '../components/cards/TeamCard.astro';
import FeaturedTags from '../components/cards/FeaturedTags.astro';
import ArrowIcon from '../components/icons/ArrowIcon.astro';
import { getPosts, getAuthors, getCategories } from '../lib/content';
import { postUrl } from '../lib/utils';

const [posts, authors, categories] = await Promise.all([getPosts(), getAuthors(), getCategories()]);
const featured = posts.filter((p) => p.isFeatured).slice(0, 3);
const latest = posts.slice(0, 6);
