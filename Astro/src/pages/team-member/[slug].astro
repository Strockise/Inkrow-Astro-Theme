---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Cta from '../../components/Cta.astro';
import BlogCard from '../../components/cards/BlogCard.astro';
import { getPosts, getAuthors, type Author, type Post } from '../../lib/content';
import { CMS_IMAGE_SIZES } from '../../lib/ix';

export const getStaticPaths = (async () => {
  const [authors, posts] = await Promise.all([getAuthors(), getPosts()]);
  return authors.map((author) => ({
    params: { slug: author.slug },
    props: { author, posts: posts.filter((p) => p.author?.slug === author.slug) },
  }));
}) satisfies GetStaticPaths;

const { author, posts } = Astro.props as { author: Author; posts: Post[] };
---

<BaseLayout pageId="6ac8862e03365f3b469b46a5" title={author.name} description={author.bio} image={author.avatar?.src}>
<div id="smooth-wrapper" class="page-wrap">
    <div id="smooth-content" class="smooth-content">
      <Navbar variant="base" />
      <div class="main">
        <section class="authors-details-section">
          <div class="w-layout-blockcontainer main-container mid-width w-container">
            <div class="authors-content-block">
              <div class="authors-overview">
                <div data-w-id="7c572a77-1c61-4b3e-f881-4eb0c9afa3c9" style="-webkit-transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0" class="authors-details-header-content">
                  <div class="section-header-block">
                    <div class="header-block">
                      <h1 class="display-header">{author.name}</h1>
                    </div>
                    <div class="summery-block top-20px width-450px">
                      <p class="body-text-default opacity-70">{author.bio}</p>
                    </div>
                  </div>
                  <div class="authors-community-block">
                    <div class="body-text-default">Social media</div>
                    <div class="authors-community-links">
                      {author.social.x && (<a href={author.social.x} target="_blank" rel="noopener" class="community-link w-inline-block">
                        <div aria-label="community-icon" class="community-icon w-embed"><svg width="100%" height="100%" viewbox="0 0 21 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M16.368 0H19.4202L12.7535 7.21556L20.625 17H14.4403L9.62098 11.0689L4.07882 17H1.02661L8.1752 9.29333L0.625 0H6.97038L11.3479 5.44L16.368 0ZM15.2836 15.2622H16.9704L6.04669 1.62444H4.1993L15.2836 15.2622Z" fill="currentColor"></path>
                          </svg></div>
                      </a>)}
                      {author.social.facebook && (<a href={author.social.facebook} target="_blank" rel="noopener" class="community-link w-inline-block">
                        <div aria-label="community-icon" class="community-icon w-embed"><svg width="100%" height="100%" viewbox="0 0 11 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M10.2197 10.6068L10.738 7.19417H7.496V4.97959C7.496 4.04596 7.94886 3.13592 9.40098 3.13592H10.875V0.230583C10.875 0.230583 9.53726 0 8.25833 0C5.5882 0 3.84304 1.63437 3.84304 4.5932V7.19417H0.875V10.6068H3.84304V18.8566C4.43817 18.9509 5.04815 19 5.66952 19C6.29089 19 6.90087 18.9509 7.496 18.8566V10.6068H10.2197Z" fill="currentColor"></path>
                          </svg></div>
                      </a>)}
                      {author.social.instagram && (<a href={author.social.instagram} target="_blank" rel="noopener" class="community-link w-inline-block">
                        <div aria-label="community-icon" class="community-icon w-embed"><svg width="25" height="24" viewbox="0 0 25 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M3.375 12C3.375 7.52166 3.375 5.28249 4.76624 3.89124C6.15749 2.5 8.39666 2.5 12.875 2.5C17.3533 2.5 19.5925 2.5 20.9838 3.89124C22.375 5.28249 22.375 7.52166 22.375 12C22.375 16.4783 22.375 18.7175 20.9838 20.1088C19.5925 21.5 17.3533 21.5 12.875 21.5C8.39666 21.5 6.15749 21.5 4.76624 20.1088C3.375 18.7175 3.375 16.4783 3.375 12Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
                            <path d="M17.375 12C17.375 14.4853 15.3603 16.5 12.875 16.5C10.3897 16.5 8.375 14.4853 8.375 12C8.375 9.51472 10.3897 7.5 12.875 7.5C15.3603 7.5 17.375 9.51472 17.375 12Z" stroke="currentColor" stroke-width="1.5"></path>
                            <path d="M18.382 6.5H18.373" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                          </svg></div>
                      </a>)}
                      {author.social.linkedin && (<a href={author.social.linkedin} target="_blank" rel="noopener" class="community-link w-inline-block">
                        <div aria-label="community-icon" class="community-icon w-embed"><svg width="17" height="16" viewbox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9.6864 8.98945V15.0195H6.32031V4.44627H9.52119V6.38744H9.63821C9.87225 5.74038 10.2715 5.23329 10.836 4.86617C11.4004 4.49445 12.0727 4.30859 12.8529 4.30859C13.5963 4.30859 14.241 4.47609 14.7871 4.8111C15.3378 5.14151 15.7646 5.60501 16.0675 6.20159C16.375 6.79358 16.5264 7.48653 16.5218 8.28044V15.0195H13.1557V8.94126C13.1603 8.35386 13.0112 7.89495 12.7083 7.56454C12.41 7.23413 11.9947 7.06892 11.4624 7.06892C11.109 7.06892 10.797 7.14693 10.5262 7.30296C10.26 7.4544 10.0535 7.67238 9.90667 7.95691C9.76441 8.24143 9.69098 8.58561 9.6864 8.98945Z" fill="currentColor"></path>
                            <path d="M0.812786 15.02V4.44681H4.17887V15.02H0.812786ZM2.49927 3.21465C2.0266 3.21465 1.62046 3.05862 1.28087 2.74656C0.94128 2.42991 0.771484 2.04902 0.771484 1.60388C0.771484 1.16333 0.94128 0.787026 1.28087 0.474969C1.62046 0.158323 2.0266 0 2.49927 0C2.97653 0 3.38267 0.158323 3.71767 0.474969C4.05726 0.787026 4.22705 1.16333 4.22705 1.60388C4.22705 2.04902 4.05726 2.42991 3.71767 2.74656C3.38267 3.05862 2.97653 3.21465 2.49927 3.21465Z" fill="currentColor"></path>
                          </svg></div>
                      </a>)}
                    </div>
                  </div>
                </div>
                <div data-w-id="d8621ebe-fb8f-8308-b989-01838a655277" style="-webkit-transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0" class="authors-image-block">{author.avatar && <img src={author.avatar.src} loading="lazy" alt={author.avatar.alt} sizes={CMS_IMAGE_SIZES} srcset={author.avatar.srcset} class="authors-image" />}</div>
              </div>
              <div class="authors-liner"></div>
              <div class="author-articals">
                <div data-w-id="32f786ad-14f8-f36f-a9b1-67970ac6babb" style="-webkit-transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 25%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0" class="section-header-block flex-verticle-center">
                  <div class="header-block">
                    <h2 class="section-header">Articles</h2>
                  </div>
                </div>
                <div class="releated-articals-cms-block w-dyn-list">
                  <div role="list" class="releated-articals-cms-list w-dyn-items">
  {posts.map((post) => (
    <div role="listitem" class="releated-articals-cms-item w-dyn-item">
      <div class="blog-cms-card">
        <BlogCard post={post} ids={{ card: 'c82b6adf-42fd-36da-f5fe-a06052d6a600', tag: 'c82b6adf-42fd-36da-f5fe-a06052d6a605', header: 'c82b6adf-42fd-36da-f5fe-a06052d6a60c', link: 'c82b6adf-42fd-36da-f5fe-a06052d6a60e' }} />
      </div>
    </div>
  ))}
</div>
{posts.length === 0 && <div class="w-dyn-empty"><div>No items found.</div></div>}
                </div>
              </div>
            </div>
          </div>
        </section>
        <Cta pageId="6ac8862e03365f3b469b46a5" />
      </div>
      <Footer />
    </div>
  </div>
</BaseLayout>
