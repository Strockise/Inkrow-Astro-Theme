---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Cta from '../components/Cta.astro';
import BlogCard from '../components/cards/BlogCard.astro';
import CategoryCard from '../components/cards/CategoryCard.astro';
import TeamCard from '../components/cards/TeamCard.astro';
import FeaturedTags from '../components/cards/FeaturedTags.astro';
import { getPosts, getAuthors, getCategories } from '../lib/content';
import { CMS_IMAGE_SIZES } from '../lib/ix';
import { postUrl } from '../lib/utils';

const [posts, allAuthors, categories] = await Promise.all([getPosts(), getAuthors(), getCategories()]);
const showcase = posts.filter((p) => p.isShowcase).slice(0, 1);
const featured = posts.filter((p) => p.isFeatured && !p.isShowcase).slice(0, 2);
const popular = categories.filter((c) => c.isPopular).slice(0, 5);
const latest = posts.slice(0, 3);
const authors = allAuthors.slice(0, 3);
---

<BaseLayout pageId="6ac8862e03365f3b469b46a6">
<div class="page-wrap">
    <Navbar variant="base" />
    <div class="main">
      <section class="home-v2-section">
        <div class="w-layout-blockcontainer main-container w-container">
