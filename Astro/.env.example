# Base URL of your Strapi instance (no trailing slash)
STRAPI_URL=http://localhost:1337

# Optional: read-only Strapi API token (Settings → API Tokens → "Read-only").
# Not needed when the Public role is allowed to find/findOne articles, authors and categories.
STRAPI_TOKEN=

# Your production URL – used for canonical and Open Graph URLs
SITE_URL=https://example.com
